{
  "name": "dsh-rewind",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面端回滚插件：代码回滚 + 会话回滚（悬停消息一键回退，快照式、不碰 git）",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rewind",
    "checkpoint",
    "rollback"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "files": [
    "lib",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L0251314/dsh-rewind.git"
  },
  "author": {},
  "license": "MIT"
}
