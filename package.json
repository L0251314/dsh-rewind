{
  "name": "dsh-rewind",
  "version": "0.1.0",
  "description": "DSH 代码回滚与对话恢复插件：影子 git 全树快照 + 会话分叉回退（Trae / Claude Code /rewind 风格）。每轮对话尾部撤回图标、/rewind 命令、checkpoint_* agent 工具，恢复精确到 tree hash 校验。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "checkpoint",
    "rollback",
    "rewind",
    "time-travel"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
